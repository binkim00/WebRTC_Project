# Local development environment variables for infra/local/docker-compose.local.yml
# Copy this file to .env and edit values as needed.

# MySQL
DB_NAME=melly
DB_USERNAME=melly_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_PORT=3306

# Redis
REDIS_PORT=6379

# LiveKit local development
# 신호(WebSocket) 포트만 자유롭게 바꿀 수 있다.
# 미디어 포트(TCP 7881, UDP 7882)는 1:1 매핑이 필수라 compose 에 고정돼 있다.
LIVEKIT_HTTP_PORT=17880

# 브라우저가 미디어를 받을 주소다. 같은 PC에서 개발하면 그대로 둔다.
# 다른 기기에서 접속하려면 이 호스트의 LAN IP(예: 192.168.0.10)로 바꾼다.
LIVEKIT_NODE_IP=127.0.0.1

# 아래 세 값은 이 compose 가 쓰지 않는다. 백엔드 .env 에 넣어야 하는 값이다.
# 키와 시크릿은 livekit.local.yaml 의 keys 와 반드시 같아야 토큰이 수락된다.
#   LIVEKIT_URL=ws://localhost:17880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=melly_local_dev_secret_1234567890abcdef
