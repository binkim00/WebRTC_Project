# Local development environment variables for infra/local/docker-compose.local.yml
# Copy this file to .env and edit values as needed.

# MySQL
DB_NAME=melly
DB_USERNAME=melly_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_PORT=3306

# Redis
REDIS_PORT=6379

# LiveKit local development
LIVEKIT_HTTP_PORT=17880
LIVEKIT_TCP_PORT=17881
LIVEKIT_API_KEY=melly_local_dev
LIVEKIT_API_SECRET=melly_local_dev_secret_1234567890abcdef
