# ==========================
# Database
# ==========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ==========================
# Redis
# ==========================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================
# Docker
# ==========================
DOCKER_PASSWORD=

# ==========================
# Spring
# ==========================
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://i15e106.p.ssafy.io

# ==========================
# 서비스 운영자(ADMIN) 계정
# ==========================
# ADMIN은 회원가입으로 만들 수 없고 시드 SQL은 local 프로파일에서만 실행된다.
# DB를 초기화한 뒤 기동하면 활성 ADMIN이 하나도 없을 때만 아래 값으로 계정을 한 번 만든다.
# 이미 운영자가 있으면 아무 일도 하지 않으므로 매 배포마다 다시 만들어지지 않는다.
# 세 값 중 하나라도 비우면 계정을 만들지 않는다.
ADMIN_BOOTSTRAP_LOGIN_ID=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NICKNAME=멜리관리자

# ==========================
# LiveKit (Production)
# ==========================
LIVEKIT_URL=wss://i15e106.p.ssafy.io
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TEST_TOKEN_ENABLED=false
# Egress worker image. The normal deploy.sh does not start the egress profile.
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.13.0
# PoC-only isolated output directory.
EGRESS_POC_OUTPUT_ROOT=/srv/melly/uploads/egress-poc

# ==========================
# Recording storage
# ==========================
# 녹화 파일을 저장할 호스트 경로다. backend 컨테이너에 같은 경로로 마운트되므로
# 컨테이너를 다시 만들어도 파일이 남는다. 배포 전에 호스트에 디렉터리를 만들어 둔다.
#   sudo mkdir -p /srv/melly/uploads
# backend 는 root 로 실행되므로 chown 이 필요 없지만, Egress worker 는
# uid 1001(egress) 로 실행되어 아래 하위 디렉터리에 쓰기 권한이 필요하다.
# 없으면 녹화가 끝까지 진행된 뒤 파일 저장에서 "permission denied" 로 실패한다.
#   sudo mkdir -p /srv/melly/uploads/egress /srv/melly/uploads/egress-backup
#   sudo chown -R 1001:0 /srv/melly/uploads/egress /srv/melly/uploads/egress-backup
RECORDING_STORAGE_ROOT=/srv/melly/uploads
# 업로드 완료 후 보관 기간(일)이며 지나면 만료 스케줄러가 파일을 지운다.
RECORDING_RETENTION_DAYS=7
# 백엔드 자동 Egress 시작 기능. 8단계 저장 경로 연동과 운영 검증 전에는 false로 둔다.
RECORDING_EGRESS_ENABLED=false
RECORDING_EGRESS_OUTPUT_ROOT=/out
RECORDING_EGRESS_LAYOUT=grid
RECORDING_EGRESS_MAX_CONCURRENT=1
RECORDING_EGRESS_CAPACITY_LEASE_SECONDS=7200
RECORDING_EGRESS_RECOVERY_CHECK_DELAY_MS=30000
RECORDING_EGRESS_RECOVERY_STALE_SECONDS=60
RECORDING_EGRESS_RECOVERY_BATCH_SIZE=20

# ==========================
# Attachment storage
# ==========================
# 공지 첨부파일을 저장할 호스트 경로다. 녹화와 마찬가지로 backend 컨테이너에 같은
# 경로로 마운트되므로 컨테이너를 다시 만들어도 파일이 남는다.
#   sudo mkdir -p /srv/melly/attachments && sudo chown 1000:1000 /srv/melly/attachments
ATTACHMENT_STORAGE_ROOT=/srv/melly/attachments

# ==========================
# Password reset (비밀번호 찾기)
# ==========================
# 발송 수단과 발신 주소는 위 메일 설정을 그대로 따른다. 아래 값은 전부 생략할 수 있고,
# 생략하면 docker-compose.prod.yml 의 기본값이 쓰인다.
#
# BASE_URL 은 메일 링크가 도착할 화면 주소다. 도메인이 바뀌면 여기서 바꾼다.
# 비워 두면 compose 기본값(https://i15e106.p.ssafy.io/login)이 쓰인다.
#PASSWORD_RESET_BASE_URL=https://i15e106.p.ssafy.io/login
# 재설정 링크 유효 시간(초). 기본 30분.
#PASSWORD_RESET_TTL_SECONDS=1800
# 같은 이메일로 다시 보낼 수 있기까지의 최소 간격(초).
#PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# 집계 구간과 그 안에서 허용할 최대 발송 횟수.
#PASSWORD_RESET_MAX_SEND_PER_WINDOW=5
#PASSWORD_RESET_SEND_WINDOW_SECONDS=3600
#
# PASSWORD_RESET_EXPOSE_LINK 는 운영에서 쓰지 않는다. 재설정 토큰 원문을 응답과 로그에
# 드러내는 개발용 설정이고, 운영 프로파일에서 켜면 백엔드가 기동하지 않는다.
# compose 에서 아예 전달하지 않으므로 여기에 적어도 컨테이너에는 들어가지 않는다.
