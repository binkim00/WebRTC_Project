# ==========================
# Recording storage
# ==========================
# 녹화 파일을 저장할 호스트 경로다. backend 컨테이너에 같은 경로로 마운트되므로
# 컨테이너를 다시 만들어도 파일이 남는다. 배포 전에 호스트에 디렉터리를 만들어 둔다.
#   sudo mkdir -p /srv/melly/uploads && sudo chown 1000:1000 /srv/melly/uploads
RECORDING_STORAGE_ROOT=/srv/melly/uploads
# 업로드 완료 후 보관 기간(일)이며 지나면 만료 스케줄러가 파일을 지운다.
RECORDING_RETENTION_DAYS=7
