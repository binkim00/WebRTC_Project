# Copy this file to .env, then replace placeholders with real values.
# Never commit .env or real credentials.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=melly
DB_USERNAME=melly_user
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# LiveKit (required)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Enables POST /api/v1/livekit/test-token only for local testing.
LIVEKIT_TEST_TOKEN_ENABLED=false

# Comma-separated exact origins, e.g. http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=
