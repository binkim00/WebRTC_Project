# AI
DEEPL_API_KEY=replace-me
GMS_API_KEY=replace-me
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=Melly

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=melly
DB_USERNAME=melly_user
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
ORGANIZATION_INVITATION_TTL_SECONDS=86400

# Authentication security
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_DURATION=900
SIGNUP_RATE_LIMIT_COUNT=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=600

# SMTP (이메일 인증 메일 발송)
# 비워 두면 compose.yaml 의 Mailpit(localhost:1025)으로 발송되고 http://localhost:8025 에서 확인한다.
# 실제 발송은 Brevo SMTP relay 기준이며, MAIL_USERNAME 은 Brevo SMTP 화면의 Login 값이다.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소는 SMTP 계정이 인증한 주소여야 한다. 다른 주소를 쓰면 발송이 거부된다.
MAIL_FROM=no-reply@melly.local
# Brevo 같은 실제 SMTP 를 쓸 때는 두 값을 true 로 바꾼다.
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# 이메일 인증
EMAIL_VERIFY_TTL_SECONDS=1800
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFY_SEND_LIMIT_COUNT=5
EMAIL_VERIFY_SEND_LIMIT_WINDOW_SECONDS=3600
EMAIL_VERIFY_CONFIRM_LIMIT_COUNT=10
EMAIL_VERIFY_CONFIRM_LIMIT_WINDOW_SECONDS=600
# 메일 링크가 향하는 프론트 인증 완료 화면이며 서버가 token 쿼리를 붙인다.
EMAIL_VERIFY_BASE_URL=http://localhost:5173/verify-email
# 응모 전 이메일 인증 강제 여부다. 기능이 안정화된 뒤 true 로 켠다.
APPLICATION_EMAIL_VERIFICATION_REQUIRED=false

# 기기 토큰
# 운영에서는 32바이트 이상 난수로 교체한다. 값이 바뀌면 기존 기기 해시와 대조가 끊긴다.
DEVICE_TOKEN_SECRET=replace-with-at-least-32-byte-device-secret
DEVICE_COOKIE_MAX_AGE_SECONDS=7776000
# 운영 HTTPS 에서는 true 로 바꾼다.
DEVICE_COOKIE_SECURE=false
DEVICE_COOKIE_SAME_SITE=Lax
# 같은 기기에서 다른 계정이 응모했을 때 FLAG 는 기록만, BLOCK 은 409 거부다.
APPLICATION_DEVICE_DUPLICATE_POLICY=FLAG
APPLICATION_SUBMIT_RATE_LIMIT_COUNT=5
APPLICATION_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=60

# LiveKit
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_TEST_TOKEN_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Internal service URL
SPRING_INTERNAL_URL=http://backend:8080

# 테스팅
