# AI
DEEPL_API_KEY=replace-me
GMS_API_KEY=replace-me
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=Melly

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=melly
DB_USERNAME=melly_user
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
ORGANIZATION_INVITATION_TTL_SECONDS=86400

# Authentication security
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_DURATION=900

# Email verification
# delivery=log 는 실제 메일을 보내지 않고 로그로만 남기는 개발용 모드다.
EMAIL_VERIFY_DELIVERY=log
EMAIL_VERIFY_BASE_URL=http://localhost:5173/email-verification
EMAIL_VERIFY_TTL_SECONDS=1800
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFY_MAX_SEND_PER_WINDOW=5
EMAIL_VERIFY_SEND_WINDOW_SECONDS=3600
EMAIL_VERIFY_MAX_CONFIRM_FAILURES=10
EMAIL_VERIFY_CONFIRM_FAILURE_WINDOW_SECONDS=600
# 토큰 원문 노출은 local/dev/test 프로파일에서만 켤 수 있다. 운영에서 true면 기동에 실패한다.
EMAIL_VERIFY_EXPOSE_LINK=false
# 미설정 시 JWT_SECRET을 사용한다. 운영에서는 별도 32바이트 이상 값을 권장한다.
# 빈 값은 32바이트 미만이라 기동에 실패하므로, 쓰지 않을 때는 주석으로 남겨 둔다.
#EMAIL_VERIFY_TOKEN_SECRET=

# Device token (동일 기기 다계정 응모 탐지)
DEVICE_TOKEN_COOKIE_NAME=melly_device
# HTTP로 접속하는 로컬에서는 false, 운영(HTTPS)에서는 반드시 true여야 한다.
DEVICE_TOKEN_SECURE=false
# 프론트와 백엔드 도메인이 다르면 None + Secure 조합이 필요하다.
DEVICE_TOKEN_SAME_SITE=Lax
DEVICE_TOKEN_MAX_AGE_DAYS=90
# 미설정 시 JWT_SECRET을 사용한다. 운영에서는 별도 32바이트 이상 값을 권장한다.
# 빈 값은 32바이트 미만이라 기동에 실패하므로, 쓰지 않을 때는 주석으로 남겨 둔다.
#DEVICE_TOKEN_SECRET=

# Application anti-abuse
APPLICATION_EMAIL_VERIFICATION_REQUIRED=true
# FLAG=의심 표시만, BLOCK=409 거부. 기본은 오탐을 피하기 위해 FLAG다.
APPLICATION_DEVICE_DUPLICATE_POLICY=FLAG

# LiveKit
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_TEST_TOKEN_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Internal service URL
SPRING_INTERNAL_URL=http://backend:8080

# 테스팅
